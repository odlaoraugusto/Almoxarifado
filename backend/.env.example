# Copie este arquivo para ".env" e ajuste os valores para a instalação local.

# Banco de dados (PostgreSQL local).
DATABASE_URL=postgresql+psycopg2://almoxarifado:senha@localhost:5432/almoxarifado

# Sessão / JWT — troque por um valor aleatório e secreto antes de ir para produção.
# Gere um com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-este-valor-por-um-segredo-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Identificação institucional (cabeçalho do sistema e dos relatórios).
# Sem exemplo real aqui de propósito — repositório público.
HOSPITAL_NOME=Nome do Hospital
HOSPITAL_ORGANIZACAO=Nome da Organização/Rede

# Origens liberadas para CORS (separadas por vírgula), ou "*" para liberar geral.
# Em dev, o frontend (Vite) roda em http://localhost:5173.
CORS_ORIGINS=http://localhost:5173
