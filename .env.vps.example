# Copie para ".env" nesta mesma pasta (na VPS) antes de subir o
# docker-compose.vps.yml. Nunca commitar o ".env" real — repositório
# público.

# Host "postgres" resolve via a rede Docker interna "backend" (ver
# docker-compose.vps.yml) — nunca exposto à internet.
DATABASE_URL=postgresql+psycopg2://almoxarifado:SENHA_AQUI@postgres:5432/almoxarifado

JWT_SECRET_KEY=troque-por-um-segredo-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

HOSPITAL_NOME=Nome do Hospital
HOSPITAL_ORGANIZACAO=Nome da Organização/Rede

# Hostnames reais usados pelo Traefik (docker-compose.vps.yml, regra
# Host(`...`) de cada router) — nunca hardcoded no compose commitado,
# só aqui (arquivo real ".env", gitignored).
BACKEND_HOST=almoxarifado-api.SEU-IP-OU-DOMINIO.sslip.io
FRONTEND_HOST=almoxarifado.SEU-IP-OU-DOMINIO.sslip.io

# URL real do frontend (container almoxarifado-frontend nesta mesma VPS)
# — mesmo valor de FRONTEND_HOST, mas com o esquema https:// na frente.
CORS_ORIGINS=https://almoxarifado.SEU-IP-OU-DOMINIO.sslip.io

# ---- Build args do frontend (embutidos no bundle em build time — Vite
# só lê VITE_* nesse momento, mudar aqui exige rebuild do container
# almoxarifado-frontend, não só reiniciar) ----
VITE_API_URL=https://almoxarifado-api.SEU-IP-OU-DOMINIO.sslip.io
VITE_ORGANIZACAO=Nome da Organização/Rede
VITE_HOSPITAL_NOME=Nome do Hospital
VITE_HOSPITAL_SIGLA=SIGLA
