# Copie para ".env" (mesma pasta) antes de subir docker-compose.local.yml.
# Nunca commitar o ".env" real — repositório público.

# Portas expostas nesta máquina (host) — mude se já tiver outro serviço
# usando 8000/80. O lado esquerdo é a porta do host, o direito (fixo,
# dentro do container) nunca muda. Se trocar, lembre de refletir a porta
# do backend em VITE_API_URL/CORS_ORIGINS mais abaixo.
BACKEND_PORT=8000
FRONTEND_PORT=80

# Senha do Postgres — a MESMA senha aparece duas vezes abaixo (uma vez
# pra criar o usuário do banco, outra dentro da DATABASE_URL) porque o
# docker-compose.local.yml não faz nenhuma mágica de interpolação além
# da simples substituição de ${VAR} — mais explícito, menos chance de
# errar silenciosamente.
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Host "postgres" resolve pela rede Docker interna deste compose — não
# precisa (nem deve) ser alcançável de fora do Docker.
DATABASE_URL=postgresql+psycopg2://almoxarifado:troque-por-uma-senha-forte@postgres:5432/almoxarifado

JWT_SECRET_KEY=troque-por-um-segredo-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

HOSPITAL_NOME=Nome do Hospital
HOSPITAL_ORGANIZACAO=Nome da Organização/Rede

# IP fixo desta máquina na rede interna — as outras estações vão acessar
# por ele, então NUNCA "localhost"/"127.0.0.1" aqui (ver seção 3 do guia
# de instalação, é o erro mais comum). Inclua a porta do FRONTEND se não
# for a 80 (ex.: http://192.168.10.50:8080).
CORS_ORIGINS=http://SEU_IP_FIXO_AQUI:FRONTEND_PORT_SE_NAO_FOR_80

# ---- Build args do frontend (embutidos no bundle em build time — Vite
# só lê VITE_* nesse momento; mudar aqui exige `docker compose ... up
# -d --build frontend` de novo, não só reiniciar o container) ----
# A porta aqui é a do BACKEND (BACKEND_PORT acima), não a do frontend.
VITE_API_URL=http://SEU_IP_FIXO_AQUI:8000
VITE_ORGANIZACAO=Nome da Organização/Rede
VITE_HOSPITAL_NOME=Nome do Hospital
VITE_HOSPITAL_SIGLA=SIGLA
